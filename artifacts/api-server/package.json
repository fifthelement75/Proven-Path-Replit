{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "credentials:rotate": "node --enable-source-maps ./dist/rotateCustomerCredentials.mjs",
    "credentials:backup-manifest": "node --enable-source-maps ./dist/createCustomerCredentialBackupManifest.mjs",
    "credentials:check-retirement": "node --enable-source-maps ./dist/checkCustomerCredentialRetirement.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9",
    "pino-http": "^10",
    "resend": "4.0.0",
    "stripe": "20.0.0",
    "stripe-replit-sync": "1.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.12"
  }
}
